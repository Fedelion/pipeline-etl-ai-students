# Copia questo file in .env e inserisci le tue stringhe di connessione MongoDB Atlas.
# Il file .env e' escluso dal repository (.gitignore).

# Cluster di staging: contiene la collezione 'sports' (seconda sorgente)
MONGO_URI_RAW=mongodb+srv://<utente>:<password>@<cluster-raw>.mongodb.net/?appName=<app>

# Cluster warehouse: destinazione del caricamento (collezione 'students_enriched')
MONGO_URI_DWH=mongodb+srv://<utente>:<password>@<cluster-dwh>.mongodb.net/?appName=<app>
